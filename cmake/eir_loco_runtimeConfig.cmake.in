@PACKAGE_INIT@
if(NOT DEFINED EIR_SDK_ROOT)
    set(EIR_SDK_ROOT "${PACKAGE_PREFIX_DIR}/sdk")
endif()
if(NOT EXISTS "${EIR_SDK_ROOT}/include/eir_lowlevel_sdk/EirLowLevelApi.h")
    message(FATAL_ERROR "Provide the matching SDK at ${EIR_SDK_ROOT} or set EIR_SDK_ROOT")
endif()
if(NOT TARGET EIR::lowlevel_sdk)
    add_library(EIR::lowlevel_sdk INTERFACE IMPORTED)
    set_target_properties(EIR::lowlevel_sdk PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${EIR_SDK_ROOT}/include")
endif()
if(@EIR_RUNTIME_WITH_ROS2@)
    include(CMakeFindDependencyMacro)
    find_dependency(rclcpp)
    find_dependency(sensor_msgs)
    find_dependency(diagnostic_msgs)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/EirLocoRuntimeTargets.cmake")
check_required_components(eir_loco_runtime)
